<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ExampleGoogleUppApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Examplegoogleupp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Examplegoogleupp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Declares support for Google Wallet Bounce Provisioning. Google Wallet uses
              queryIntentActivities to find issuer apps that declare this intent, then offers this
              app as an "Add card" shortcut for cards already known to Google.

              Docs: https://developers.google.com/pay/issuers/apis/push-provisioning/android/bounce-provisioning
            -->
            <intent-filter>
                <action android:name="com.google.android.gms.tapandpay.issuer.ACTION_INITIATE_PROVISIONING" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          App-to-app verification (IDV) invocada por Google Wallet cuando hace falta confirmar
          la identidad del cliente (Yellow Path) durante el agregado de una tarjeta Visa.

          Visa define un formato fijo para la acción: "{package name}.a2a".

          Docs: https://developers.google.com/pay/issuers/tsp-integration/app-to-app-idv
        -->
        <activity
            android:name=".a2a.AppToAppVerificationActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">

            <intent-filter>
                <action android:name="com.example.example_google_upp.a2a" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
