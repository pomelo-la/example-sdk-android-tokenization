<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ExampleGoogleUppApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Examplegoogleupp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Examplegoogleupp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
        App2App (IDV / "yellow path") step-up: Google Wallet launches this Activity when Visa
        needs cardholder verification to activate a token. The action must match exactly what
        Visa registers for this app: "{banking app identifier}.a2a" (fixed "a2a" service name).
        Mastercard/MDES would need a second intent-filter with a different action assigned in
        MDES Manager, out of scope for this Visa-only example.
        -->
        <activity
            android:name=".wallet.VisaAppToAppVerificationActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Examplegoogleupp">
            <intent-filter>
                <action android:name="com.example.example_google_upp.a2a" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
