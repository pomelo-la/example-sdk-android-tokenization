<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ExampleGoogleUppApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Examplegoogleupp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Examplegoogleupp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Dedicated entry point for Google Wallet Bounce Provisioning. Google Wallet uses
          queryIntentActivities to find issuer apps that declare ACTION_INITIATE_PROVISIONING, then
          offers this app as an "Add card" shortcut for cards already known to Google.

          taskAffinity="" + launchMode="singleTask" keep this Activity in its own task, isolated
          from MainActivity's back stack, so finish() always returns the user to Google Wallet
          regardless of whether the app was already open (hot start) or not running (cold start).

          Docs: https://developers.google.com/pay/issuers/apis/push-provisioning/android/bounce-provisioning
        -->
        <activity
            android:name=".BounceProvisioningActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Examplegoogleupp">
            <intent-filter>
                <action android:name="com.google.android.gms.tapandpay.issuer.ACTION_INITIATE_PROVISIONING" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
